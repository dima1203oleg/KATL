{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace=@katl/web run dev",
    "dev:api": "npm --workspace=@katl/api run dev",
    "dev:worker": "npm --workspace=@katl/worker run dev",
    "legacy:dev": "vite",
    "start": "npm --workspace=@katl/web run start",
    "build": "npm run build:legacy && npm run build:web && npm run build:api && npm run build:worker",
    "build:legacy": "vite build",
    "build:web": "npm --workspace=@katl/web run build",
    "build:api": "npm --workspace=@katl/api run build",
    "build:worker": "npm --workspace=@katl/worker run build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm --workspace=@katl/api run typecheck && npm --workspace=@katl/worker run typecheck && tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck": "npm run lint",
    "test": "NODE_ENV=test tsx --env-file=.env --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "NODE_ENV=test tsx --env-file=.env --test tests/unit/*.test.ts",
    "test:integration": "NODE_ENV=test tsx --env-file=.env --test tests/integration/*.test.ts",
    "db:migrate": "npm --workspace=@katl/database run migrate",
    "db:seed": "npm --workspace=@katl/database run seed",
    "user:provision": "tsx scripts/provision-user.ts",
    "test:e2e": "playwright test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
