# =============================================================================
# KATL BESS Platform — Environment Configuration Template
# Copy to .env for local development (Do NOT commit .env with real secrets to Git)
# =============================================================================

# Server & Runtime
NODE_ENV=development
PORT=3000
API_PORT=4000
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=https://catl.site
# Locale geo-redirect trusts x-vercel-ip-country or cf-ipcountry only when the edge proxy overwrites them.

# PostgreSQL Relational Database
DATABASE_URL=postgresql://katl_user:katl_password@localhost:5432/katl_production
POSTGRES_DB=katl_production
POSTGRES_USER=katl_user
POSTGRES_PASSWORD=your_secure_db_password

# Redis Cache & Background Queue Broker
REDIS_URL=redis://localhost:6379

# Authentication & Encryption
SESSION_SECRET=change_me_to_a_random_32_character_secret_key
JWT_PRIVATE_KEY=change_me_to_a_random_jwt_private_signing_key
CRM_WEBHOOK_TOKEN=

# AI Provider Gateway (Leave empty for NOT_CONFIGURED state)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# S3-Compatible Object Storage (Snapshots & Datasheets)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=katl-snapshots
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mail & Notifications (RFQ alerts)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=admin@katl-energy.com.ua
